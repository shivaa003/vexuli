# Same-origin deployment needs no frontend URL override.
# PORT=3001
# NODE_ENV=production
# TRUST_PROXY=1
# ALLOWED_ORIGINS=https://your-domain.example
# STUN_URLS=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302

# Configure coturn or a compatible TURN service for restrictive networks.
# TURN_URLS=turn:turn.your-domain.example:3478?transport=udp,turns:turn.your-domain.example:5349?transport=tcp
# TURN_SHARED_SECRET=long-random-secret-shared-with-coturn

# Only if the frontend is built for a separate domain.
# VITE_APP_SERVER_ORIGIN=https://api.your-domain.example